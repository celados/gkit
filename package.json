{
	"name": "gkit",
	"private": true,
	"workspaces": {
		"packages": [
			"packages/gkit"
		],
		"catalog": {
			"@types/bun": "^1.3.10",
			"@types/node": "^25.6.0",
			"@valibot/to-json-schema": "^1.6.0",
			"ajv": "^8.20.0",
			"@celados/argc": "^11.0.0",
			"bun-types": "^1.3.13",
			"dataforseo-client": "^2.0.25",
			"dotenv": "^17.2.2",
			"google-auth-library": "^10.9.0",
			"typescript": "^7.0.2",
			"valibot": "^1.2.0",
			"vitest": "^4.0.18",
			"yaml": "^2.9.0"
		}
	},
	"type": "module",
	"scripts": {
		"cli": "bun run --filter gkit cli",
		"eval": "bun run --filter gkit eval:slice5",
		"typecheck": "harness typecheck",
		"check": "vp check && harness typecheck && fallow dead-code && bun run generate:check && bun run test",
		"generate:check": "bun run --filter gkit generate:check",
		"test": "bun run --filter gkit test:once",
		"verify:package": "bun run ./packages/gkit/scripts/verify-package-artifact.ts",
		"prepare": "vp config"
	},
	"devDependencies": {
		"@celados/harness": "^0.1.3",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"bun-types": "catalog:",
		"fallow": "^3.42.0",
		"tsrs": "0.24.0-ts7.1.0-beta",
		"typescript": "catalog:",
		"vite-plus": "^1.6.0",
		"vitest": "catalog:"
	},
	"packageManager": "bun@1.3.10"
}
