{
  "name": "gkit",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/gkit"
    ],
    "catalog": {
      "@types/bun": "^1.3.10",
      "@types/node": "^25.6.0",
      "@valibot/to-json-schema": "^1.6.0",
      "ajv": "^8.20.0",
      "argc": "github:ethan-huo/argc#v7.11.1",
      "bun-types": "^1.3.13",
      "dataforseo-client": "^2.0.25",
      "dotenv": "^17.2.2",
      "google-auth-library": "^10.9.0",
      "typescript": "^5",
      "valibot": "^1.2.0",
      "vitest": "^4.0.18",
      "yaml": "^2.9.0"
    }
  },
  "type": "module",
  "scripts": {
    "cli": "bun run --filter gkit cli",
    "eval": "bun run --filter gkit eval:slice5",
    "check-types": "bun run --filter gkit check-types",
