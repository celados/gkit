{
  "version": 1,
  "provider": "gsc",
  "manifestRevision": "2026-10-21.gsc.3",
  "reviewedAt": "2026-10-21T00:00:00.000Z",
  "entries": [
    {
      "path": "/webmasters/v3/sites",
      "method": "get",
      "operationId": "sites.list",
      "exposure": "executable",
      "capability": {
        "id": "gsc.properties.list",
        "provider": "gsc",
        "revision": "1",
        "adapterKey": "properties.list",
        "title": "List accessible Search Console properties",
        "description": "List Search Console properties accessible to the profile-bound service account.",
        "effects": ["read"],
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "examples": [
          {
            "input": {},
            "command": "gkit --profile openclaw-web gsc api call --capability-id gsc.properties.list --input '{}' --out gsc-properties.json --dry-run"
          }
        ]
      }
    },
    {
      "path": "/webmasters/v3/sites/{siteUrl}",
      "method": "get",
      "operationId": "sites.get",
      "exposure": "inventory",
      "reason": "The legacy CLI does not expose a distinct property-get workflow; properties.list carries the reviewed inventory use case."
    },
    {
      "path": "/webmasters/v3/sites/{siteUrl}",
      "method": "put",
      "operationId": "sites.add",
      "exposure": "inventory",
      "reason": "Write operation is outside Slice 4."
    },
    {
      "path": "/webmasters/v3/sites/{siteUrl}",
      "method": "delete",
      "operationId": "sites.delete",
      "exposure": "inventory",
      "reason": "Destructive operation is outside Slice 4."
    },
    {
      "path": "/webmasters/v3/sites/{siteUrl}/searchAnalytics/query",
      "method": "post",
      "operationId": "searchanalytics.query",
      "exposure": "executable",
      "capability": {
        "id": "gsc.search-analytics.query",
        "provider": "gsc",
        "revision": "1",
        "adapterKey": "search-analytics.query",
        "title": "Query Search Console performance",
        "description": "Run one provider-native Search Analytics read for the profile-bound or explicitly selected property.",
        "effects": ["read"],
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "additionalProperties": false,
          "required": ["startDate", "endDate"],
          "properties": {
            "siteUrl": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "startDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "endDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "dimensions": {
              "type": "array",
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "enum": ["country", "date", "device", "hour", "page", "query", "searchAppearance"]
              }
            },
            "type": { "enum": ["discover", "googleNews", "image", "news", "video", "web"] },
            "dataState": { "enum": ["all", "final", "hourly_all"] },
            "aggregationType": { "enum": ["auto", "byNewsShowcasePanel", "byPage", "byProperty"] },
            "rowLimit": { "type": "integer", "minimum": 1, "maximum": 25000 },
            "startRow": { "type": "integer", "minimum": 0, "maximum": 100000000 },
            "dimensionFilterGroups": {
              "type": "array",
              "maxItems": 10,
              "items": { "type": "object" }
            }
          }
        },
        "examples": [
          {
            "input": {
              "startDate": "2026-07-01",
              "endDate": "2026-07-07",
              "dimensions": ["query"],
              "rowLimit": 25
            },
            "command": "gkit --profile openclaw-web gsc api call --capability-id gsc.search-analytics.query --input @request.json --out gsc-search.json --dry-run"
          }
        ]
      }
    },
    {
      "path": "/webmasters/v3/sites/{siteUrl}/sitemaps",
      "method": "get",
      "operationId": "sitemaps.list",
      "exposure": "executable",
      "capability": {
        "id": "gsc.sitemaps.list",
        "provider": "gsc",
        "revision": "1",
        "adapterKey": "sitemaps.list",
        "title": "List Search Console sitemaps",
        "description": "List sitemaps for one Search Console property.",
        "effects": ["read"],
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "siteUrl": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "sitemapIndex": { "type": "string", "minLength": 1, "maxLength": 2048 }
          }
        },
        "examples": [
          {
            "input": {},
            "command": "gkit --profile openclaw-web gsc api call --capability-id gsc.sitemaps.list --input '{}' --out gsc-sitemaps.json --dry-run"
          }
        ]
      }
    },
    {
      "path": "/webmasters/v3/sites/{siteUrl}/sitemaps/{feedpath}",
      "method": "get",
      "operationId": "sitemaps.get",
      "exposure": "executable",
      "capability": {
        "id": "gsc.sitemaps.get",
        "provider": "gsc",
        "revision": "2",
        "adapterKey": "sitemaps.get",
        "title": "Read one Search Console sitemap",
        "description": "Read details for one exact sitemap URL under one Search Console property.",
        "effects": ["read"],
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "additionalProperties": false,
          "required": ["feedpath"],
          "properties": {
            "siteUrl": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "feedpath": { "type": "string", "minLength": 1, "maxLength": 2048 }
          }
        },
        "examples": [
          {
            "title": "Read a sitemap returned by gsc.sitemaps.list for openclaw-web",
            "input": { "feedpath": "https://openclawai.io/sitemap-index.xml" },
            "command": "gkit --profile openclaw-web gsc api call --capability-id gsc.sitemaps.get --input @request.json --out gsc-sitemap.json --dry-run"
          }
        ]
      }
    },
    {
      "path": "/webmasters/v3/sites/{siteUrl}/sitemaps/{feedpath}",
      "method": "put",
      "operationId": "sitemaps.submit",
      "exposure": "executable",
      "capability": {
        "id": "gsc.sitemaps.submit",
        "provider": "gsc",
        "revision": "1",
        "adapterKey": "sitemaps.submit",
        "title": "Submit one sitemap to Search Console",
        "description": "Submit or resubmit one exact sitemap URL for one Search Console property. Changes provider state, so it requires --allow-write, and the service account needs Full or Owner permission on the property; a Restricted user is rejected with AUTH_FAILED. Google returns an empty body, so the artifact is a gkit submission receipt with siteUrl, feedpath, and httpStatus.",
        "effects": ["write"],
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "additionalProperties": false,
          "required": ["feedpath"],
          "properties": {
            "siteUrl": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "feedpath": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^\\s/?#]+"
            }
          }
        },
        "examples": [
          {
            "title": "Submit the openclaw-web sitemap index",
            "input": { "feedpath": "https://openclawai.io/sitemap-index.xml" },
            "command": "gkit --profile openclaw-web gsc api call --capability-id gsc.sitemaps.submit --input @request.json --allow-write --out gsc-sitemap-submit.json --dry-run"
          }
        ]
      }
    },
    {
      "path": "/webmasters/v3/sites/{siteUrl}/sitemaps/{feedpath}",
      "method": "delete",
      "operationId": "sitemaps.delete",
      "exposure": "inventory",
      "reason": "Destructive operation is outside Slice 4."
    },
    {
      "path": "/v1/urlInspection/index:inspect",
      "method": "post",
      "operationId": "urlInspection.index.inspect",
      "exposure": "executable",
      "capability": {
        "id": "gsc.url-inspection.inspect",
        "provider": "gsc",
        "revision": "2",
        "adapterKey": "url-inspection.inspect",
        "title": "Inspect one URL in Google's index",
        "description": "Read Google's indexed URL inspection result for one URL under the selected property.",
        "effects": ["read"],
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "additionalProperties": false,
          "required": ["inspectionUrl"],
          "properties": {
            "siteUrl": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "inspectionUrl": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "languageCode": {
              "type": "string",
              "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
              "maxLength": 35
            }
          }
        },
        "examples": [
          {
            "title": "Inspect a URL under the openclaw-web Search Console property",
            "input": { "inspectionUrl": "https://openclawai.io/" },
            "command": "gkit --profile openclaw-web gsc api call --capability-id gsc.url-inspection.inspect --input @request.json --out gsc-inspection.json --dry-run"
          }
        ]
      }
    }
  ]
}
