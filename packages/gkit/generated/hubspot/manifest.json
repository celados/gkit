  "capabilities": [
    {
      "id": "hubspot.crm.associations.list",
      "provider": "hubspot",
      "revision": "1",
      "adapterKey": "crm.associations.list",
      "title": "List record associations",
      "description": "List bounded associations from one reviewed CRM record to one reviewed object type.",
      "effects": [
        "read"
      ],
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fromObjectType",
          "objectId",
          "toObjectType",
          "limit"
        ],
        "properties": {
          "fromObjectType": {
            "enum": [
              "companies",
              "contacts",
              "deals",
              "tickets"
            ]
          },
          "objectId": {
            "type": "string",
            "pattern": "^[1-9]\\d{0,19}$"
          },
          "toObjectType": {
            "enum": [
              "companies",
              "contacts",
              "deals",
              "tickets"
            ]
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000
          }
        }
      },
      "examples": [
        {
          "input": {
            "fromObjectType": "contacts",
            "objectId": "123",
            "toObjectType": "companies",
            "limit": 100
          },
          "command": "gkit --profile app-a hubspot api call --capability-id hubspot.crm.associations.list --input @request.json --out hubspot-associations.json --dry-run"
        }
      ]
    },
