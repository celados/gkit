      "id": "dataforseo.serp.google.organic.live.advanced",
      "provider": "dataforseo",
      "revision": "1",
      "title": "Google Organic live advanced SERP",
      "description": "Return one Google Organic live advanced SERP with a reviewed maximum depth of 10.",
      "adapterKey": "serp.google.organic.live.advanced",
      "effects": [
        "read",
        "spend"
      ],
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyword",
          "location_code",
          "language_code",
          "device",
          "os",
          "depth"
        ],
        "properties": {
          "keyword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 700,
            "not": {
              "pattern": "(?:[Aa][Ll][Ll][Ii][Nn][Aa][Nn][Cc][Hh][Oo][Rr]|[Aa][Ll][Ll][Ii][Nn][Tt][Ee][Xx][Tt]|[Aa][Ll][Ll][Ii][Nn][Tt][Ii][Tt][Ll][Ee]|[Aa][Ll][Ll][Ii][Nn][Uu][Rr][Ll]|[Dd][Ee][Ff][Ii][Nn][Ee]|[Dd][Ee][Ff][Ii][Nn][Ii][Tt][Ii][Oo][Nn]|[Ff][Ii][Ll][Ee][Tt][Yy][Pp][Ee]|[Ii][Dd]|[Ii][Nn][Aa][Nn][Cc][Hh][Oo][Rr]|[Ii][Nn][Ff][Oo]|[Ii][Nn][Tt][Ee][Xx][Tt]|[Ii][Nn][Tt][Ii][Tt][Ll][Ee]|[Ii][Nn][Uu][Rr][Ll]|[Ll][Ii][Nn][Kk]|[Rr][Ee][Ll][Aa][Tt][Ee][Dd]|[Ss][Ii][Tt][Ee]|[Cc][Aa][Cc][Hh][Ee]):"
            }
          },
          "location_code": {
            "type": "integer",
            "minimum": 1
          },
          "language_code": {
            "type": "string",
            "minLength": 2,
            "maxLength": 10
          },
          "device": {
            "type": "string",
            "enum": [
              "desktop",
              "mobile"
            ]
          },
          "os": {
            "type": "string",
            "enum": [
              "windows",
              "macos",
              "android",
              "ios"
            ]
          },
          "depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "tag": {
            "type": "string",
            "maxLength": 255
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "device": {
                  "const": "desktop"
                }
              }
            },
            "then": {
              "properties": {
                "os": {
                  "enum": [
                    "windows",
                    "macos"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "os": {
                  "enum": [
                    "android",
                    "ios"
                  ]
                }
              }
            }
          }
        ]
      },
      "cost": {
        "currency": "USD",
        "policyRevision": "dataforseo-google-organic-live-pricing-2026-07-14-v1",
        "model": {
          "type": "fixed",
          "micros": 2000
        }
      },
      "examples": [
        {
          "title": "Safe preflight",
          "input": {
            "keyword": "website cloner",
            "location_code": 2840,
            "language_code": "en",
            "device": "desktop",
            "os": "windows",
            "depth": 10
          },
          "command": "gkit --profile clonesite.ai dataforseo api call --capability-id dataforseo.serp.google.organic.live.advanced --input @req.json --allow-spend --max-spend-usd 0.002000 --out serp.json --dry-run"
        },
