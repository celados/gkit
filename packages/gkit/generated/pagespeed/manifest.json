{
  "version": 1,
  "provider": "pagespeed",
  "revision": "2026-10-27.pagespeed.read-v1.1",
  "source": {
    "url": "https://developers.google.com/speed/docs/insights/rest/v5/pagespeedapi/runpagespeed",
    "revision": "v5-reviewed-2026-10-27",
