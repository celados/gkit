{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	// Generated by `bun run generate:*` (verified by `generate:check`).
	"ignorePatterns": ["packages/gkit/generated/**", "packages/gkit/docs/providers/**", "packages/gkit/sources/**"],
	// Local-only helper that renders .npmrc from the vault; not a dependency.
	"ignoreBinaries": ["latch"],
}
